@{
    ViewBag.Title = "Giới thiệu - Thái Công Auto VN";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!--Header đầu trang-->


    <section class="about-section text-white d-flex align-items-center"
             style="background: url('/Content/images/bg-about.jpg') center center/cover no-repeat; min-height: 100vh;">
        <div class="container" style="background-color: rgba(0,0,0,0.7);">
            <h1 class="text-center fw-bold text-uppercase display-1 text-warning mb-5">Giới thiệu về Thái Công Auto VN</h1>

            <!-- PHẦN 1: GIỚI THIỆU -->
            <div class="row mb-5">
                <div class="col-md-6 d-flex align-items-center">
                    <div>
                        <h3 class="fw-bold text-warning text-uppercase">Về Chúng Tôi</h3>
                        <p>
                            Tại <strong>Thái Công Auto VN</strong>, chúng tôi mang đến trải nghiệm mua xe hơi uy tín, tiện lợi và chuyên nghiệp cho mọi khách hàng. Với nhiều năm kinh nghiệm trong ngành ô tô, chúng tôi tự hào cung cấp các dòng xe chất lượng, từ xe sang trọng đến xe gia đình, đáp ứng đa dạng nhu cầu và ngân sách.
                            Đội ngũ chuyên viên tận tâm của chúng tôi luôn sẵn sàng tư vấn, hỗ trợ lựa chọn xe phù hợp và đảm bảo các thủ tục mua bán nhanh chóng, minh bạch. Tại Thái Công Auto VN, sự hài lòng của khách hàng là ưu tiên hàng đầu – mỗi chiếc xe bán ra không chỉ là phương tiện di chuyển, mà còn là trải nghiệm an tâm và phong cách sống.
                            Hãy đến với <strong>Thái Công Auto VN</strong> – nơi giấc mơ sở hữu chiếc xe lý tưởng của bạn trở thành hiện thực.
                        </p>
                    </div>
                    <div class="col-md-6">
                        <img src="~/Content/images/showroom.jpg" alt="Showroom Thái Công Auto VN" class="img-fluid rounded shadow-lg" />
                    </div>
                </div>
            </div>

            <!-- PHẦN 2: DỊCH VỤ -->
            <div class="row mb-5">
                <div class="col-md-6 d-flex align-items-center">
                    <div>
                        <h3 class="fw-bold text-warning text-uppercase">Dịch Vụ Của Chúng Tôi</h3>
                        <p>
                            Tại <strong>Thái Công Auto VN</strong>, chúng tôi mang đến dịch vụ bán xe chuyên nghiệp, minh bạch và tận tâm.
                            Khách hàng có thể dễ dàng lựa chọn từ nhiều dòng xe mới và đã qua sử dụng, được kiểm định chất lượng kỹ lưỡng.
                            Với quy trình tư vấn nhanh chóng, hỗ trợ tài chính linh hoạt và hậu mãi chu đáo, <strong>Thái Công Auto VN</strong> cam kết giúp bạn sở hữu chiếc xe mơ ước một cách dễ dàng và an toàn nhất.
                        </p>
                    </div>
                    <div class="col-md-6">
                        <img src="~/Content/images/dich-vu.jpg" alt="Dịch vụ Thái Công Auto VN" class="img-fluid rounded shadow-lg" />
                    </div>
                </div>
            </div>

            <!-- PHẦN 3: CHÍNH SÁCH -->
            <div class="row mb-5">
                <div class="col-md-6 d-flex align-items-center">
                    <div>
                        <h3 class="fw-bold text-warning text-uppercase">Chính Sách Bán Xe</h3>
                        <p>
                            Tại <strong>Thái Công Auto VN</strong>, chúng tôi luôn đặt quyền lợi và sự hài lòng của khách hàng lên hàng đầu.
                            Mọi chiếc xe đều được kiểm định kỹ lưỡng, minh bạch về nguồn gốc và chất lượng trước khi bàn giao.
                            Khách hàng được hỗ trợ trả góp linh hoạt, thủ tục nhanh chóng, cùng chính sách bảo hành chính hãng toàn quốc theo tiêu chuẩn của từng dòng xe.
                            Chúng tôi cam kết cung cấp mức giá tốt nhất, hợp đồng rõ ràng, và giao xe tận nơi trên toàn quốc.
                            <strong>Thái Công Auto VN</strong> luôn nỗ lực mang đến dịch vụ uy tín, chuyên nghiệp và đảm bảo sự an tâm tuyệt đối khi bạn lựa chọn chiếc xe phù hợp cho hành trình của mình.
                        </p>
                    </div>
                    <div class="col-md-6">
                        <img src="~/Content/images/chinh-sach.jpg" alt="Chính sách Thái Công Auto" class="img-fluid rounded shadow-lg" />
                    </div>
                </div>
            </div>

            <!-- PHẦN 4: SỨ MỆNH-->
            <div class="row mb-5">
                <div class="col-12">
                    <h3 class="fw-bold text-warning text-uppercase">Sứ Mệnh Của Chúng Tôi</h3>
                    <p>
                        Sứ mệnh của <strong>Thái Công Auto VN</strong> là mang đến những chiếc xe chất lượng cao,
                        cùng trải nghiệm mua hàng tận tâm và dịch vụ hậu mãi trọn đời, giúp khách hàng
                        an tâm tận hưởng niềm vui sở hữu một chiếc xe hoàn hảo.
                    </p>
                </div>
            </div>

            <!-- PHẦN 5: CÂU CHUYỆN THƯƠNG HIỆU-->
            <div class="row mb-5">
                <div class="col-12">
                    <h3 class="fw-bold text-warning text-uppercase">Câu Chuyện Thương Hiệu</h3>
                    <p>
                        <strong>Thái Công Auto VN</strong> được thành lập từ năm 2015 với khát vọng thay đổi cách mua bán xe ô tô tại Việt Nam.
                        Bắt đầu từ một cơ sở nhỏ, bằng niềm đam mê và sự am hiểu sâu sắc về xe hơi,
                        chúng tôi đã xây dựng được uy tín vững chắc trong lòng khách hàng.
                        Mỗi chiếc xe bán ra không chỉ là một sản phẩm, mà là lời cam kết về chất lượng và sự an toàn.
                    </p>
                </div>
            </div>

            <!-- PHẦN 6: TẦM NHÌN-->
            <div class="row mb-5">
                <div class="col-md-6">
                    <h3 class="fw-bold text-warning text-uppercase">Tầm Nhìn</h3>
                    <p>
                        Trở thành đại lý ô tô đáng tin cậy hàng đầu, được khách hàng lựa chọn đầu tiên
                        nhờ vào chất lượng dịch vụ vượt trội và danh mục xe đa dạng.
                    </p>
                </div>
            </div>

            <!-- PHẦN 7: GIÁ TRỊ CỐT LÕI-->
            <div class="row mb-5">
                <div class="col-md-6">
                    <h3 class="fw-bold text-warning text-uppercase">Giá Trị Cốt Lõi</h3>
                    <ul>
                        <li><strong>Chính Trực:</strong> Minh bạch trong mọi giao dịch.</li>
                        <li><strong>Chất Lượng:</strong> Xe được kiểm định nghiêm ngặt trước khi giao.</li>
                        <li><strong>Tận Tâm:</strong> Luôn lắng nghe và tư vấn phù hợp.</li>
                        <li><strong>Chuyên Nghiệp:</strong> Quy trình rõ ràng, hiệu quả.</li>
                    </ul>
                </div>
            </div>

            <!-- PHẦN 8: ĐỘI NGŨ CỦA CHÚNG TÔI -->
            <div class="row mb-5">
                <div class="col-12">
                    <h3 class="fw-bold text-warning text-uppercase">Đội Ngũ Của Chúng Tôi</h3>
                    <h4>Những con người tạo nên giá trị của Thái Công Auto VN.</h4>
                </div>

                <div class="col-md-4 text-center">
                    <img src="~/Content/images/team1.jpg" class="img-fluid rounded mb-3" />
                    <h5 class="text-warning">Nguyễn Văn A</h5>
                    <h4>Người Sáng Lập – "Uy tín tạo nên thương hiệu."</h4>
                </div>

                <div class="col-md-4 text-center">
                    <img src="~/Content/images/team2.jpg" class="img-fluid rounded mb-3" />
                    <h5 class="text-warning">Trần Thị B</h5>
                    <h4>Giám Đốc Kinh Doanh – "Tận tâm trong từng tư vấn."</h4>
                </div>

                <div class="col-md-4 text-center">
                    <img src="~/Content/images/team3.jpg" class="img-fluid rounded mb-3" />
                    <h5 class="text-warning">Lê Văn C</h5>
                    <h4>Trưởng Phòng Kỹ Thuật – "An toàn luôn là số 1."</h4>
                </div>
            </div>

            <!-- PHẦN 9: CTA -->
            <div class="row text-center my-5">
                <h3 class="fw-bold text-warning text-uppercase">Sẵn Sàng Sở Hữu Chiếc Xe Mơ Ước?</h3>
                <h4>Liên hệ ngay để được tư vấn miễn phí hoặc xem danh sách xe.</h4>

                <div class="mt-5">
                    <div class="d-flex flex-column gap-3 custom-indent" style="max-width: 400px; margin: 0 0 0 50px;">
                        <a href="/Home/Contact" class="btn btn-warning btn-lg py-3 fw-bold" style="font-size:1.2rem; min-width: 300px; text-indent: 0;">📞 Liên hệ tư vấn(Contact)</a><br>
                        <a href="/Car/Index" class="btn btn-outline-light btn-lg py-3 fw-bold" style="font-size:1.2rem; min-width: 300px; text-indent: 0;">🚗 Xem danh sách xe(Products)</a>
                    </div>
                </div>
            </div>
        </div>
    </section>



    <style>
        /*Nền toàn bộ trang*/
        body {
            background-image: url('../images/xe hơi.png');
            background-size: cover;
            background-attachment: fixed;
            background-color: #000;
            background-position: center center;
            background-repeat: no-repeat;
        }
        /*Khối nội dung nổi bật*/
        .about-section .container {
            padding: 55px 75px; /*Giảm padding để nội dung có nhiều không gian hơn*/
            border-radius: 30px; /*Giảm bo góc cho phù hợp*/
            background-color: rgba(0, 0, 0, 0.3); /*Màu nền tối hơn để dễ đọc*/
            backdrop-filter: blur(3px); /*Giữ hiệu ứng làm mờ*/
            -webkit-backdrop-filter: blur(3px);
            box-shadow: 0 0 30px rgba(250, 250, 250, 0.3); /*Thêm ánh vàng cho bóng*/
            overflow: hidden;
            isolation: isolate;
            max-width: 1500px; /*Giới hạn chiều rộng phù hợp*/
            margin: 130px auto; /*Thêm khoảng cách trên dưới*/
            text-align: justify;
            width: 95%; /*Chiếm 95% chiều rộng màn hình*/
        }
        /*Kích thước, font, màu chữ*/
        /*Chỉnh kích thước tiêu đề*/
        .about-section h1 {
            font-size: 3.0rem;
            font-weight: bold;
            text-transform: uppercase;
            color: #fff;
            text-align: left;
            margin-bottom: 5.0rem;
        }
        /*Chỉnh văn bản các phần*/
        .about-section p {
            font-size: 1.5rem;
            color: #fff;
            text-indent: 120px;
            line-height: 1.5;
            margin-bottom: 2rem;
        }

        .about-section h3 {
            font-size: 2.0rem;
            font-weight: bold;
            color: #fff;
            text-transform: uppercase;
            margin: 5.5rem 0 1rem 0;
        }

        .about-section h4 {
            font-size: 1.8rem;
            color: #fff;
            line-height: 1.5;
            margin-bottom: 2rem;
        }

        .about-section h5 {
            font-size: 1.4rem;
            font-weight: bold;
            text-align: center;
            color: #fff;
            margin: 1rem 0 0.5rem 0;
        }

        .about-section ul li {
            font-size: 1.5rem;
            color: #fff;
            line-height: 2.5;
            margin-bottom: 0.5rem;
        }

        .about-section * {
            font-family: 'Slab-Serif', 'Times New Roman', 'Arial', Tahoma;
            text-shadow: 2px 2px 4px rgba(0,0,0,0.5);
        }
    </style>

